# ==========================================
# Semantic Comment Analyze - Environment Config
# ==========================================

# CORS Allowed Origins (comma-separated list of trusted origins)
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Batch Processing Constraints
# Maximum rows allowed per CSV batch processing request
P2_MAX_BATCH_ROWS=10000

# Optional model data & cache directory overrides
# P2_DATA_DIR=/path/to/data
# HF_HOME=/path/to/huggingface/cache
# P2_MODEL_CACHE_DIR=/path/to/models

